SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxx
SUPABASE_SERVICE_KEY=sb_secret_xxxx

# Mercado Pago.
MP_ACCESS_TOKEN=APP_USR_xxxx
MP_WEBHOOK_SECRET=xxxx

# Opcional: duración máxima de la preapproval que se crea en MP.
MP_SUBSCRIPTION_YEARS=2

# En localhost, APP_URL debe ser una URL pública si quieres recibir webhooks de MP
# (por ejemplo la URL HTTPS de ngrok o Cloudflare Tunnel).
APP_URL=https://xxxx.ngrok-free.app

# Endpoints /api/cron/*
CRON_SECRET=xxxx
