SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxx
SUPABASE_SERVICE_KEY=sb_secret_xxxx

# Mercado Pago sandbox/local.
# Usa el access token del usuario de prueba vendedor.
MP_ACCESS_TOKEN=TEST-xxxx
MP_WEBHOOK_SECRET=xxxx

# Opcional en sandbox: email real del usuario comprador de prueba de MP.
# Si está seteado y MP_ACCESS_TOKEN empieza con TEST-, se usa como payer_email.
MP_TEST_PAYER_EMAIL=test_user_xxxx@testuser.com
MP_SUBSCRIPTION_YEARS=2

# Override temporal para pruebas controladas en producción. Mercado Pago CLP
# exige monto mínimo 950.
MP_TEST_AMOUNT=1000

# En localhost, APP_URL debe ser una URL pública si quieres recibir webhooks de MP
# (por ejemplo la URL HTTPS de ngrok o Cloudflare Tunnel).
APP_URL=https://xxxx.ngrok-free.app

# Endpoints /api/cron/*
CRON_SECRET=xxxx
